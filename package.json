{
  "name": "ekosys-solar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean.js",
    "dev": "node scripts/clean.js && next dev",
    "build": "node scripts/clean.js && node --max-old-space-size=4096 node_modules/next/dist/bin/next build && node scripts/post-build.js && node scripts/sync-analysis.js",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "sync:analysis": "node scripts/sync-analysis.js"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "nodemailer": "^9.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
